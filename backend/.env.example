# Backend
NODE_ENV=development
PORT=4000

# CORS: адрес фронтенда
FRONTEND_URL=http://localhost:3000

# JWT
JWT_SECRET=change-me-please
JWT_EXPIRES_IN=1d

# PostgreSQL
# ВНИМАНИЕ: для development и test использовать РАЗНЫЕ базы.
# Никогда не указывайте здесь production-базу или чужую существующую базу проекта.
# Команда `prisma migrate reset` УНИЧТОЖИТ все данные в базе, на которую указывает DATABASE_URL.
DATABASE_URL=postgresql://root:123456@localhost:5433/products_dev?schema=public

# Для интеграционных/API тестов задавайте отдельную базу через окружение:
#   TEST_DATABASE_URL=postgresql://root:123456@localhost:5433/products_test?schema=public

# Collector API (для внешних систем, которые тянут наши данные).
# Если оба значения не заданы — /api/v1/collector/* отвечает 401.
# Ключ передаётся клиентом в заголовке `X-API-Key`.
# COLLECTOR_ORG_ID — id организации, чьи данные отдаются под этим ключом.
COLLECTOR_API_KEY=
COLLECTOR_ORG_ID=
