generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  admin
  manager
  employee
}

enum Unit {
  PIECE
  GRAM
  KILOGRAM
  MILLILITER
  LITER
  PACK
  BOX
  BOTTLE
  CAN
  BAG
}

model Organization {
  id          String   @id @default(uuid())
  name        String
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users     User[]
  positions Position[]
  zones     Zone[]
  suppliers  Supplier[]
  categories Category[]
  products   Product[]

  @@map("organizations")
}

model Category {
  id             String   @id @default(uuid())
  organizationId String
  name           String
  normalizedName String
  description    String?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  products     Product[]

  @@unique([organizationId, normalizedName])
  @@index([organizationId])
  @@index([organizationId, isActive])
  @@index([organizationId, name])
  @@map("categories")
}

model Product {
  id                 String   @id @default(uuid())
  organizationId     String
  categoryId         String?
  name               String
  normalizedName     String
  description        String?
  baseUnit           Unit
  sku                String?
  normalizedSku      String?
  barcode            String?
  normalizedBarcode  String?
  isInventoryTracked Boolean  @default(true)
  isPurchasable      Boolean  @default(true)
  isActive           Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  category     Category?    @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  @@unique([organizationId, normalizedName])
  @@unique([organizationId, normalizedSku])
  @@unique([organizationId, normalizedBarcode])
  @@index([organizationId])
  @@index([organizationId, categoryId])
  @@index([organizationId, isActive])
  @@index([organizationId, isInventoryTracked])
  @@index([organizationId, isPurchasable])
  @@index([organizationId, baseUnit])
  @@map("products")
}

model Supplier {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  normalizedName String
  contactPerson  String?
  phone          String?
  email          String?
  address        String?
  taxId          String?
  notes          String?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, normalizedName])
  @@index([organizationId])
  @@index([organizationId, isActive])
  @@index([organizationId, name])
  @@map("suppliers")
}

model User {
  id             String   @id @default(cuid())
  organizationId String
  positionId     String?
  email          String   @unique
  passwordHash   String
  name           String
  role           Role     @default(employee)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  position     Position?    @relation(fields: [positionId], references: [id], onDelete: SetNull)
  zones        UserZone[]

  @@index([organizationId])
  @@index([positionId])
  @@map("users")
}

model Position {
  id             String   @id @default(uuid())
  organizationId String
  name           String
  normalizedName String
  description    String?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  users        User[]

  @@unique([organizationId, normalizedName])
  @@index([organizationId])
  @@map("positions")
}

model Zone {
  id             String   @id @default(uuid())
  organizationId String
  name           String
  normalizedName String
  description    String?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  users        UserZone[]

  @@unique([organizationId, normalizedName])
  @@index([organizationId])
  @@map("zones")
}

model UserZone {
  id            String   @id @default(uuid())
  userId        String
  zoneId        String
  isResponsible Boolean  @default(false)
  createdAt     DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  zone Zone @relation(fields: [zoneId], references: [id], onDelete: Cascade)

  @@unique([userId, zoneId])
  @@index([zoneId])
  @@index([userId])
  @@map("user_zones")
}
