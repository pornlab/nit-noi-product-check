generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  admin
  manager
  employee
}

enum Unit {
  PIECE
  GRAM
  KILOGRAM
  MILLILITER
  LITER
  PACK
  BOX
  BOTTLE
  CAN
  BAG
}

enum InventorySessionStatus {
  DRAFT
  COMPLETED
  CANCELLED
}

model Organization {
  id          String   @id @default(uuid())
  name        String
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users     User[]
  positions Position[]
  zones     Zone[]
  suppliers          Supplier[]
  categories         Category[]
  products           Product[]
  inventorySessions  InventorySession[]
  productZones       ProductZone[]
  receivings         Receiving[]
  disposals          Disposal[]

  @@map("organizations")
}

model Category {
  id             String   @id @default(uuid())
  organizationId String
  name           String
  normalizedName String
  description    String?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  products     Product[]

  @@unique([organizationId, normalizedName])
  @@index([organizationId])
  @@index([organizationId, isActive])
  @@index([organizationId, name])
  @@map("categories")
}

model Product {
  id                 String   @id @default(uuid())
  organizationId     String
  categoryId         String?
  name               String
  normalizedName     String
  description        String?
  baseUnit           Unit
  sku                String?
  normalizedSku      String?
  barcode            String?
  normalizedBarcode  String?
  isInventoryTracked Boolean  @default(true)
  isPurchasable      Boolean  @default(true)
  isActive           Boolean  @default(true)
  minQuantity        Decimal? @db.Decimal(12, 3)
  optimalQuantity    Decimal? @db.Decimal(12, 3)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  category       Category?       @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  inventoryItems InventoryItem[]
  zones          ProductZone[]
  receivingItems ReceivingItem[]
  disposalItems  DisposalItem[]

  @@unique([organizationId, normalizedName])
  @@unique([organizationId, normalizedSku])
  @@unique([organizationId, normalizedBarcode])
  @@index([organizationId])
  @@index([organizationId, categoryId])
  @@index([organizationId, isActive])
  @@index([organizationId, isInventoryTracked])
  @@index([organizationId, isPurchasable])
  @@index([organizationId, baseUnit])
  @@map("products")
}

model InventorySession {
  id             String                 @id @default(cuid())
  organizationId String
  sequenceNumber Int
  zoneId         String
  createdById    String
  status         InventorySessionStatus @default(COMPLETED)
  startedAt      DateTime               @default(now())
  completedAt    DateTime?

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  zone         Zone            @relation(fields: [zoneId], references: [id], onDelete: Restrict)
  createdBy    User            @relation(fields: [createdById], references: [id], onDelete: Restrict)
  items        InventoryItem[]

  @@unique([organizationId, sequenceNumber])
  @@index([organizationId])
  @@index([organizationId, zoneId])
  @@index([organizationId, zoneId, completedAt])
  @@index([createdById])
  @@map("inventory_sessions")
}

model InventoryItem {
  id                 String    @id @default(cuid())
  inventorySessionId String
  productId          String
  quantity           Decimal   @db.Decimal(12, 3)
  updatedAt          DateTime  @default(now()) @updatedAt
  updatedById        String?

  session   InventorySession @relation(fields: [inventorySessionId], references: [id], onDelete: Cascade)
  product   Product          @relation(fields: [productId], references: [id], onDelete: Restrict)
  updatedBy User?            @relation("InventoryItemUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  @@unique([inventorySessionId, productId])
  @@index([productId])
  @@map("inventory_items")
}

model ProductZone {
  id             String   @id @default(uuid())
  organizationId String
  productId      String
  zoneId         String
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  product      Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  zone         Zone         @relation(fields: [zoneId], references: [id], onDelete: Cascade)

  @@unique([productId, zoneId])
  @@index([organizationId, zoneId])
  @@index([organizationId, productId])
  @@map("product_zones")
}

model Supplier {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  normalizedName String
  contactPerson  String?
  phone          String?
  email          String?
  address        String?
  taxId          String?
  notes          String?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  receivings   Receiving[]

  @@unique([organizationId, normalizedName])
  @@index([organizationId])
  @@index([organizationId, isActive])
  @@index([organizationId, name])
  @@map("suppliers")
}

model User {
  id             String   @id @default(cuid())
  organizationId String
  positionId     String?
  email          String   @unique
  passwordHash   String
  name           String
  role           Role     @default(employee)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization         Organization       @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  position             Position?          @relation(fields: [positionId], references: [id], onDelete: SetNull)
  zones                UserZone[]
  inventorySessions    InventorySession[]
  editedInventoryItems InventoryItem[]    @relation("InventoryItemUpdatedBy")
  createdReceivings    Receiving[]
  createdDisposals     Disposal[]

  @@index([organizationId])
  @@index([positionId])
  @@map("users")
}

model Position {
  id             String   @id @default(uuid())
  organizationId String
  name           String
  normalizedName String
  description    String?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  users        User[]

  @@unique([organizationId, normalizedName])
  @@index([organizationId])
  @@map("positions")
}

model Zone {
  id             String   @id @default(uuid())
  organizationId String
  name           String
  normalizedName String
  description    String?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization         Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  users                UserZone[]
  inventorySessions    InventorySession[]
  products             ProductZone[]
  receivingAllocations ReceivingAllocation[]
  disposals            Disposal[]

  @@unique([organizationId, normalizedName])
  @@index([organizationId])
  @@map("zones")
}

model Receiving {
  id             String   @id @default(cuid())
  organizationId String
  sequenceNumber Int
  supplierId     String
  receivedAt     DateTime @db.Date
  currency       String   @default("THB") @db.VarChar(3)
  deliveryCost   Decimal  @db.Decimal(12, 2)
  createdById    String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  supplier     Supplier        @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  createdBy    User            @relation(fields: [createdById], references: [id], onDelete: Restrict)
  items        ReceivingItem[]

  @@unique([organizationId, sequenceNumber])
  @@index([organizationId])
  @@index([organizationId, receivedAt])
  @@index([supplierId])
  @@index([createdById])
  @@map("receivings")
}

model ReceivingItem {
  id          String  @id @default(cuid())
  receivingId String
  productId   String
  quantity    Decimal @db.Decimal(12, 3)
  cost        Decimal @db.Decimal(12, 2)

  receiving   Receiving             @relation(fields: [receivingId], references: [id], onDelete: Cascade)
  product     Product               @relation(fields: [productId], references: [id], onDelete: Restrict)
  allocations ReceivingAllocation[]

  @@unique([receivingId, productId])
  @@index([productId])
  @@map("receiving_items")
}

model ReceivingAllocation {
  id              String  @id @default(cuid())
  receivingItemId String
  zoneId          String
  quantity        Decimal @db.Decimal(12, 3)

  item ReceivingItem @relation(fields: [receivingItemId], references: [id], onDelete: Cascade)
  zone Zone          @relation(fields: [zoneId], references: [id], onDelete: Restrict)

  @@unique([receivingItemId, zoneId])
  @@index([zoneId])
  @@map("receiving_allocations")
}

model Disposal {
  id             String   @id @default(cuid())
  organizationId String
  zoneId         String
  createdById    String
  createdAt      DateTime @default(now())

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  zone         Zone            @relation(fields: [zoneId], references: [id], onDelete: Restrict)
  createdBy    User            @relation(fields: [createdById], references: [id], onDelete: Restrict)
  items        DisposalItem[]

  @@index([organizationId])
  @@index([organizationId, createdAt])
  @@index([zoneId])
  @@index([createdById])
  @@map("disposals")
}

model DisposalItem {
  id         String  @id @default(cuid())
  disposalId String
  productId  String
  quantity   Decimal @db.Decimal(12, 3)

  disposal Disposal @relation(fields: [disposalId], references: [id], onDelete: Cascade)
  product  Product  @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@unique([disposalId, productId])
  @@index([productId])
  @@map("disposal_items")
}

model UserZone {
  id            String   @id @default(uuid())
  userId        String
  zoneId        String
  isResponsible Boolean  @default(false)
  createdAt     DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  zone Zone @relation(fields: [zoneId], references: [id], onDelete: Cascade)

  @@unique([userId, zoneId])
  @@index([zoneId])
  @@index([userId])
  @@map("user_zones")
}
